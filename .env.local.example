# ---------------------------------------------------------------------------
# Cubicle env template — copy to `.env.local` for local work
# ---------------------------------------------------------------------------
# https://supabase.com/dashboard/project/_/settings/api
#
# EXACT names required (watch spelling: SUPABASE not SUBASE):
#   NEXT_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY   ← never NEXT_PUBLIC_
#
# LOCAL SAFETY (default):
#   On `npm run dev` / localhost, platform data (carts, bookings, issues,
#   staff ops) stays in a browser sandbox — even if production Supabase keys
#   are pasted below. Production staff will NOT see your local experiments.
#
#   Google auth may still use these keys for sign-in testing. That does not
#   re-enable remote carts/bookings unless you opt in (see below).
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Canonical public URL (metadata, calendar links). Production default: https://mycubicle.app
# NEXT_PUBLIC_SITE_URL=https://mycubicle.app

# Optional: local demo teacher/admin picker (never enable on Vercel production)
# NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true

# ---------------------------------------------------------------------------
# DANGEROUS — opt-in only
# Point platform data at the Supabase project above while developing locally.
# Prefer a STAGING project. Never leave this true with production school keys
# unless you intentionally want live data on your laptop.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_CUBICLE_USE_REMOTE_IN_DEV=true

# Production-only hard lock (set on Vercel Production, not local)
# NEXT_PUBLIC_CUBICLE_REQUIRE_REMOTE=true

# Optional explicit env label: local | production
# NEXT_PUBLIC_CUBICLE_ENV=local
